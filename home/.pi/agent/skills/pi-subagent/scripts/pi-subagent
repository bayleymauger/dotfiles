#!/usr/bin/env bash
# Spawn pi subagents in tmux panes/windows (or background processes without
# tmux) and collect their results.
# Run state lives in $PI_SUBAGENT_DIR/<name>/ (default /tmp/pi-subagents):
#   prompt.md, run.sh, mode, parent, pane|pid, log, output.md, exit_code, .done,
#   .collected (output already handed to the parent; see extensions/notify.ts)
set -euo pipefail

ROOT=${PI_SUBAGENT_DIR:-/tmp/pi-subagents}
SKILL=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PROFILES=$SKILL/profiles
TIERS=$SKILL/tiers

usage() {
  cat <<'EOF'
usage: pi-subagent <command> [args]

  spawn [opts] [PROMPT] [-- PI_ARGS...]   start a subagent, print its name
      -a, --agent PROFILE    worker profile: a name from profiles/ or a .md path
                             (sets model, tools, and a role prompt)
      -n, --name NAME        run name (default: <agent>-<time>-<rand>)
      -f, --prompt-file F    read prompt from file (- for stdin)
      -i, --interactive      full pi TUI the user can watch and steer (tmux only)
                             default: one-shot `pi -p`, pane closes when done
      --pane                 split the current window instead of a new window
      --no-tmux              run as a background process even inside tmux
      -C, --cwd DIR          working directory (default: $PWD)
      -m, --model MODEL      provider/id[:thinking]; default: the profile's tier
                             model for the current provider (see tiers), else
                             the current session's model and thinking
  wait [-t SECS] NAME...      block until each run is done, print its output
                             (default timeout 1800s; exits 124 on timeout)
  send NAME MESSAGE|-f FILE   send a follow-up to an interactive run
  peek NAME [LINES]           show the last LINES (default 40) of its pane/log
  list                        list runs and their status
  kill NAME...                stop a run
  profiles                    list worker profiles
  tiers [--update]            check tier models against pi's model list;
                             --update moves rows to the newest version

Without tmux ($TMUX unset) runs are background `pi -p --no-session`
processes, the same way pi's example subagent extension runs them.
EOF
}

die() { echo "pi-subagent: $*" >&2; exit 1; }

# Profile files are markdown: `---` frontmatter (description, tier or model,
# tools, fork) followed by the role prompt.
fm() { awk 'NR==1 && /^---$/ {f=1; next} f && /^---$/ {exit} f' "$1" | sed -n "s/^$2:[[:space:]]*//p"; }
body() { awk 'c>=2; /^---$/ && c<2 {c++}' "$1"; }

# A profile's model: its pinned `model:`, else its tier's model for the
# parent's provider. Empty means inherit the parent's model.
profile_model() {
  local m t
  m=$(fm "$1" model); t=$(fm "$1" tier)
  [[ -z $m && -n $t ]] || { echo "$m"; return; }
  awk -v p="${PI_PROVIDER:-}" -v t="$t" '!/^#/ && $1==p && $2==t {print $3; exit}' "$TIERS"
}

run_dir() {
  [[ -d $ROOT/$1 ]] || die "no run named '$1' (see: pi-subagent list)"
  echo "$ROOT/$1"
}

alive() {
  # not `display -t`: it silently falls back to the current pane if the target is gone
  if [[ -e $1/pane ]]; then tmux has-session -t "$(<"$1/pane")" 2>/dev/null
  else kill -0 "$(<"$1/pid")" 2>/dev/null; fi
}

status() {
  if [[ -e $1/.done ]]; then echo done
  elif alive "$1"; then echo running
  else echo dead; fi
}

cmd_spawn() {
  local name="" layout=window mode=print use_tmux=1 cwd=$PWD model="" prompt="" pfile="" agent="" pf=""
  local -a extra=()
  while (($#)); do
    case $1 in
      -a|--agent) agent=$2; shift 2 ;;
      -n|--name) name=$2; shift 2 ;;
      -f|--prompt-file) pfile=$2; shift 2 ;;
      -i|--interactive) mode=interactive; shift ;;
      --pane) layout=pane; shift ;;
      --window) layout=window; shift ;;
      --no-tmux) use_tmux=0; shift ;;
      -C|--cwd) cwd=$2; shift 2 ;;
      -m|--model) model=$2; shift 2 ;;
      --) shift; extra=("$@"); break ;;
      -*) die "unknown option: $1" ;;
      *) [[ -z $prompt ]] || die "unexpected argument: $1"; prompt=$1; shift ;;
    esac
  done

  # Subagents get PI_SUBAGENT=1; refusing here stops runaway recursive spawning.
  [[ -z ${PI_SUBAGENT:-} ]] || die "nested subagents are disabled; do the work yourself"
  [[ -n ${TMUX:-} ]] || use_tmux=0
  if [[ $mode == interactive && $use_tmux == 0 ]]; then
    echo "pi-subagent: no tmux, so --interactive falls back to a one-shot run" >&2
    mode=print
  fi
  if [[ -n $agent ]]; then
    if [[ -f $agent ]]; then pf=$agent; else pf=$PROFILES/$agent.md; fi
    [[ -f $pf ]] || die "no profile '$agent' (see: pi-subagent profiles)"
    agent=$(basename "$pf" .md)
  fi
  name=${name:-${agent:-sub}-$(date +%H%M%S)-$RANDOM}
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "name may only contain letters, digits, . _ -"
  cwd=$(cd "$cwd" && pwd) || die "bad --cwd"

  local dir=$ROOT/$name
  [[ ! -e $dir ]] || die "$dir already exists; pick another --name"
  mkdir -p "$dir"
  if [[ -n $pfile ]]; then cat -- "$pfile" >"$dir/prompt.md"
  elif [[ -n $prompt ]]; then printf '%s\n' "$prompt" >"$dir/prompt.md"
  fi
  [[ -s $dir/prompt.md ]] || { rm -rf "$dir"; die "no prompt given"; }
  echo "$mode" >"$dir/mode"
  echo "${agent:--}" >"$dir/agent"
  echo "${PI_SESSION_ID:-}" >"$dir/parent"

  local -a args=()
  if [[ -z $model && -n $pf ]]; then
    model=$(profile_model "$pf")
    [[ -n $model || -z $(fm "$pf" tier) ]] ||
      echo "pi-subagent: no $(fm "$pf" tier) tier for provider '${PI_PROVIDER:-?}' in $TIERS; using the parent's model" >&2
  fi
  if [[ -n $model ]]; then
    args+=(--model "$model")
  elif [[ -n ${PI_PROVIDER:-} && -n ${PI_MODEL:-} ]]; then
    # Inherit the parent's model and thinking level, like pi's subagent example.
    args+=(--model "$PI_PROVIDER/$PI_MODEL")
    [[ -z ${PI_REASONING_LEVEL:-} ]] || args+=(--thinking "$PI_REASONING_LEVEL")
  fi
  [[ -z $pf || -z $(fm "$pf" tools) ]] || args+=(--tools "$(fm "$pf" tools)")
  [[ -z $pf ]] || body "$pf" >>"$dir/system.md"

  # fork: start from a copy of the parent's conversation. The forked session is
  # stored in the run dir so it doesn't clutter the user's session list.
  local -a session=(--no-session)
  if [[ -n $pf && $(fm "$pf" fork) == true ]]; then
    if [[ -f ${PI_SESSION_FILE:-} ]]; then session=(--session-dir "$dir" --fork "$PI_SESSION_FILE")
    else echo "pi-subagent: no \$PI_SESSION_FILE to fork; starting fresh" >&2; fi
  fi
  args+=("${extra[@]}")

  local d q
  d=$(printf %q "$dir")
  {
    echo "cd $(printf %q "$cwd")"
    echo "export PI_SUBAGENT=1"
    if [[ $mode == print ]]; then
      q=$(printf '%q ' "${session[@]}" "${args[@]}")
      [[ ! -s $dir/system.md ]] || q="--append-system-prompt $d/system.md $q"
      echo "printf '\e[1mpi subagent %s\e[0m (one-shot; output appears when done)\n\n' $(printf %q "$name")"
      echo "pi -p $q -- \"\$(<$d/prompt.md)\" </dev/null | tee $d/output.md"
      echo "echo \${PIPESTATUS[0]} >$d/exit_code"
    else
      cat >>"$dir/system.md" <<EOF

You are a subagent: another pi agent spawned you in a tmux pane to do one task, and the user may watch or type here too.
When you finish the task, and again after every follow-up message, write your complete final answer to $dir/output.md (overwrite it), then run \`touch $dir/.done\`.
The parent agent reads only that file, so make it self-contained: results, file paths you changed, and anything left unresolved.
EOF
      [[ ${session[0]} == --no-session ]] && session=()
      q=$(printf '%q ' --name "subagent: $name" "${session[@]}" "${args[@]}")
      echo "pi --append-system-prompt $d/system.md $q -- \"\$(<$d/prompt.md)\""
      echo "echo \$? >$d/exit_code"
    fi
    echo "touch $d/.done"
  } >"$dir/run.sh"

  local cmd="bash $d/run.sh"
  if [[ $use_tmux == 0 ]]; then
    # setsid: own process group, so `kill` can stop pi and its tool children
    setsid bash "$dir/run.sh" >"$dir/log" 2>&1 </dev/null &
    echo $! >"$dir/pid"
  elif [[ $layout == pane ]]; then
    tmux split-window -d -h -t "${TMUX_PANE:-}" -c "$cwd" -P -F '#{pane_id}' "$cmd" >"$dir/pane"
  else
    tmux new-window -d -n "$name" -c "$cwd" -P -F '#{pane_id}' "$cmd" >"$dir/pane"
  fi
  echo "$name"
}

cmd_wait() {
  local timeout=1800
  if [[ ${1:-} == -t || ${1:-} == --timeout ]]; then timeout=$2; shift 2; fi
  (($#)) || die "wait: give at least one run name"
  local deadline=$((SECONDS + timeout)) n dir i
  for n in "$@"; do
    # tolerate a wait issued in parallel with its spawn: give the run a moment to appear
    for ((i = 0; i < 20; i++)); do
      [[ -e $ROOT/$n/pane || -e $ROOT/$n/pid ]] && break
      sleep 0.5
    done
    dir=$(run_dir "$n")
    while [[ ! -e $dir/.done ]] && alive "$dir"; do
      if ((SECONDS >= deadline)); then
        echo "pi-subagent: timed out; still running: $n (wait again, peek, or kill)" >&2
        exit 124
      fi
      sleep 2
    done
    touch "$dir/.collected"
    echo "=== $n ($(status "$dir"), exit $(cat "$dir/exit_code" 2>/dev/null || echo '?')) ==="
    if [[ -s $dir/output.md ]]; then cat "$dir/output.md"
    else
      echo "(no output.md; the subagent stopped before reporting)"
      [[ ! -s $dir/log ]] || tail -n 20 "$dir/log"
    fi
    echo
  done
}

cmd_send() {
  local n=${1:?send: NAME required} dir msg pane
  shift
  dir=$(run_dir "$n")
  [[ $(<"$dir/mode") == interactive ]] || die "$n is a one-shot run; spawn a new one instead"
  alive "$dir" || die "$n's pane is gone"
  if [[ ${1:-} == -f ]]; then msg=$(cat -- "${2:?send -f: FILE required}"); else msg=${1:?send: MESSAGE required}; fi
  pane=$(<"$dir/pane")
  rm -f "$dir/.done" "$dir/.collected"
  # bracketed paste keeps multi-line messages from submitting early
  printf '%s' "$msg" | tmux load-buffer -b "pi-subagent-$n" -
  tmux paste-buffer -p -d -b "pi-subagent-$n" -t "$pane"
  sleep 0.3
  tmux send-keys -t "$pane" Enter
}

cmd_peek() {
  local dir; dir=$(run_dir "${1:?peek: NAME required}")
  if [[ -e $dir/pid ]]; then tail -n "${2:-40}" "$dir/log"; return; fi
  alive "$dir" || die "$1's pane is gone; output: $dir/output.md"
  # strip TUI padding: trailing spaces and runs of blank lines
  tmux capture-pane -p -J -t "$(<"$dir/pane")" -S "-${2:-40}" | sed 's/[[:space:]]*$//' | cat -s
}

cmd_list() {
  local dir
  for dir in "$ROOT"/*/; do
    [[ -e $dir/mode ]] || continue
    dir=${dir%/}
    printf '%-28s %-17s %-12s %-8s %s\n' "${dir##*/}" "$(cat "$dir/agent" 2>/dev/null || echo -)" "$(<"$dir/mode")" "$(status "$dir")" "$dir"
  done
}

cmd_profiles() {
  local f
  for f in "$PROFILES"/*.md; do
    printf '%-17s %-9s %-34s %s\n' "$(basename "$f" .md)" "$(fm "$f" tier | grep . || echo -)" \
      "$(profile_model "$f" | grep . || echo inherit)" "$(fm "$f" description)"
  done
}

cmd_kill() {
  local n dir
  for n in "$@"; do
    dir=$(run_dir "$n")
    if [[ -e $dir/pane ]]; then tmux kill-pane -t "$(<"$dir/pane")" 2>/dev/null || true
    else kill -- "-$(<"$dir/pid")" 2>/dev/null || true; fi
  done
}

cmd=${1:-}
shift || true
case $cmd in
  spawn|wait|send|peek|list|kill|profiles) "cmd_$cmd" "$@" ;;
  tiers) node "$SKILL/scripts/tiers.js" "$TIERS" "$@" ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 2 ;;
esac
